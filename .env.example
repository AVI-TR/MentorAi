# Mentor AI - Environment Configuration
PROJECT_NAME="Mentor AI"
ENVIRONMENT="development"
DEBUG=false
API_V1_STR="/api/v1"

# Server Configuration
HOST="127.0.0.1"
PORT=8000

# CORS Configuration (comma-separated or JSON list of explicit origins)
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://127.0.0.1:3000", "http://127.0.0.1:5173"]

# Database Configuration (Synchronous SQLite for local development)
DATABASE_URL="sqlite:///./mentor_ai.db"
SQL_ECHO=false
